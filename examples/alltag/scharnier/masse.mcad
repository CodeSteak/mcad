// Maße des Scharniers (per include): Länge, Augen, Spiele
laenge = 60;
augen = 5;              // Anzahl Gelenkaugen (ungerade: A außen)
auge_r = 4;             // Außenradius der Augen
blatt_t = 2.5;          // Blattstärke
spiel = 0.4;            // axiales und radiales Spiel zwischen A und B
bohrung_a = 3.0;        // Bohrung Blatt A (Stift wird eingeklebt)
bohrung_b = 3.4;        // Bohrung Blatt B (dreht frei auf dem Stift)
stift_d = 2.95;         // (3,0 in 3,0: deckungsgleiche Zylinder, Vereinigung scheitert, README: F11)
