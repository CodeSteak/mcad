# Arch package mcad (repository controller-cad; package name up to 0.2: controller-cad): `mcad` with desktop UI (Tauri 2, WebKitGTK 4.1) and CLI.
#
# Built via the Makefile in the repository root:
#   make arch-pkg      # makepkg on Arch Linux, otherwise in an archlinux container (Docker)
#   make arch-test     # install and check the package in a fresh container
# `make arch-pkg` puts the source archive (git archive HEAD) into target/arch, copies this
# file there and sets pkgver (<Cargo version>.r<commits>.g<hash>) and _srcsum.
# Directly with makepkg: first `make dist`, then set pkgver/_srcsum as above.
#
# The kernel solidcore (Apache-2.0, Rust) is a git dependency of crates/kernel-solidcore,
# fetched by `cargo fetch` in prepare().

pkgname=mcad
pkgver=0.3.0
pkgrel=1
pkgdesc='Parametric CAD in an OpenSCAD dialect with exact B-rep (solidcore): CLI mcad and desktop UI'
arch=('x86_64')
url='https://github.com/CodeSteak/controller-cad'
# Project: MIT; solidcore: Apache-2.0; fonts: OFL-1.1; crates/UI: MIT, Apache-2.0
# up to 0.2.x the package and program were called controller-cad and cad
provides=('controller-cad')
conflicts=('controller-cad')
replaces=('controller-cad')
license=('MIT' 'Apache-2.0' 'OFL-1.1')
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'shared-mime-info'
  'webkit2gtk-4.1'
)
makedepends=(
  'cargo'
  'git'
  'nodejs'
  'pnpm'
)
# lto: C objects of crates' build scripts as GCC LTO objects cannot be resolved by rustc when
# linking. debug: debug info of the Tauri/WebKit bindings costs several GB.
options=('!lto' '!debug')
_srcsum=SKIP
source=("$pkgname-$pkgver.tar.gz")
sha256sums=("$_srcsum")

prepare() {
  cd "$pkgname-$pkgver"
  # Network access only here: crates (solidcore from git) and pnpm packages
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
  (cd web && pnpm install --frozen-lockfile)
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$PWD/target"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/$pkgname"
  make app CARGO_FLAGS=--frozen
}

check() {
  cd "$pkgname-$pkgver"
  local mcad="$PWD/target/release/mcad"
  export MCAD_NO_DAEMON=1
  "$mcad" --version
  "$mcad" check tests/models/spec/housing.mcad
  "$mcad" check tests/models/openscad-compat/05_nested_booleans.scad   # .scad still opens
  "$mcad" render tests/models/spec/housing.mcad -o "$srcdir/check-housing.png" --module housing --views all
  "$mcad" export tests/models/spec/bottle.mcad -o "$srcdir/check-bottle.step"
  # without a graphical session: message and exit 2 (the UI is embedded, not the placeholder)
  local rc=0
  env -u DISPLAY -u WAYLAND_DISPLAY "$mcad" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 2 ]
  [ ! -e web/dist-tauri/placeholder ]
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
