# File name = app ID = "identifier" in crates/cad-app/tauri.conf.json: the app sets it as the
# GLib program name, so it is the Wayland app_id and the X11 WM_CLASS (icon in the taskbar).
# File types: text/x-mcad (*.mcad) and application/x-openscad (*.scad), both in mcad.xml.
[Desktop Entry]
Type=Application
Version=1.5
Name=mcad
GenericName=Parametric CAD
GenericName[de]=Parametrisches CAD
Comment=Parametric CAD in an OpenSCAD dialect with grids, anchors and fillet zones
Comment[de]=Parametrisches CAD im OpenSCAD-Dialekt mit Rastern, Ankern und Fillet-Zonen
Exec=mcad %f
TryExec=mcad
Icon=mcad
Terminal=false
Categories=Graphics;3DGraphics;Engineering;
Keywords=CAD;MCAD;OpenSCAD;SCAD;3D;STEP;STL;3MF;
MimeType=text/x-mcad;application/x-openscad;
StartupNotify=true
StartupWMClass=dev.mcad.desktop
