// F13 (message): shell(2) of a body whose bottom edges are rounded with r 2 (inner radius
// 0): before only „SmApiShellBrepFull failed: SM_ERR (1001)“.
// Status (report 13): fixed – the message now names the cause (rounding radius ≤
// wall thickness, the inner face degenerates); with fillet(3) it works.
// SOLL-FEHLER: radius of a convex rounding
grid g { z: o = 30; }
shell(2) {
    fillet(2) {
        box([0, 0, 0], [50, 40, 30]);
        zone(g[*, *, 0], d = 1);
    }
    zone(g.o, d = 1);
}
