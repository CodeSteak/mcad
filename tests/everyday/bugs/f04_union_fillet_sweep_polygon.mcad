// F4 (minor): union(fillet) on a sweep with a 32-gon profile fails (many facet edges);
// with circle it works (key rack hook).
// Status (report 13): open – the sweep succeeds, rounding the 32 facet edges at the
// circular edge of the peg fails in SMLib (SM_ERR); workaround circle().
// EXPECT: error-free
union(fillet = 1) {
    cylinder([0, 0, 0], [0, 8, 0], d = 8);
    sweep(path = [[0, 0, 0], [0, -13, -1], [0, -22, 4], [0, -23, 10]])
        polygon([for (i = [0 : 31]) 3 * [cos(i * 360 / 32), sin(i * 360 / 32)]]);
}
