// F10: union(fillet = 1) of a rounded shell (shell) and a boss near the
// inner corner: the result is only the boss with its fillet, the shell is missing; status ok,
// volume 0 mm³. With the boss at (30, 30) the result is right (~26 000 mm³).
// Status (report 13): reported instead of silently wrong (rounding yields open body → error,
// the union remains); a correct fillet is open (it runs onto the bottom rounding).
// EXPECT: error-free
// EXPECT-VOLUME-MIN: 20000
grid g {
    x: l = 0, r = 80;
    y: v = 0, h = 60;
    z: u = 0, o = 32;
}
union(fillet = 1) {
    shell(2) {
        fillet(3.5) {
            fillet(5) {
                box(g[l, v, u], g[r, h, o]);
                zone(g[l, v, *], d = 1);
                zone(g[r, v, *], d = 1);
                zone(g[l, h, *], d = 1);
                zone(g[r, h, *], d = 1);
            }
            zone(g.u, d = 1);
        }
        zone(g.o, d = 1);
    }
    translate([7.5, 7.5, 1.5]) cylinder(h = 30.5, d = 7);
}
