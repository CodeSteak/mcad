// Zweck: mug with handle (approx. 370 ml when full) – conical solid of revolution (rotate_extrude), bottom
// rounded via a zone at the bottom plane, opened at the top with shell, drinking rim rounded via a
// second zone; handle as a sweep of a circle along a spline path (ends
// radial in the wall), attached with union(fillet = …). Dimensions in mm.

// Radius of the outer wall at height z (linear from bottom to top)
function radius_bei(z, ru, ro, h) = ru + (ro - ru) * z / h;

module becher(ru = 36, ro = 41, h = 95, wand = 2.8, boden_r = 6, henkel_d = 9) {
    // Profile of the solid of revolution: x = radius, y = height
    grid p {
        x: achse = 0, unten = ru, oben = ro;
        y: boden = 0, rand = h;
    }
    // Space: zones and handle
    grid g {
        x: achse = 0;
        z: boden = 0, henkel_u = 22, henkel_o = h - 18, rand = h;
    }
    r1 = radius_bei(g.henkel_u, ru, ro, h);
    r2 = radius_bei(g.henkel_o, ru, ro, h);
    weite = 30;    // Distance of the handle from the wall

    union(fillet = 1.5) {
        fillet(1.2) {
            shell(wand) {
                fillet(boden_r) {
                    rotate_extrude()
                        polygon([p[achse, boden], p[unten, boden], p[oben, rand], p[achse, rand]]);
                    zone(g.boden, d = 1);
                }
                zone(g.rand, d = 1);     // Open the top
            }
            zone(g.rand, d = 1);         // Round the drinking rim inside and outside
        }
        sweep(path = [[r2 - wand / 2, 0, g.henkel_o], [r2 + 4, 0, g.henkel_o + 0.5],
                      [r2 + weite * 0.6, 0, g.henkel_o + 3],
                      [ro + weite, 0, (g.henkel_u + g.henkel_o) / 2 + 6],
                      [r1 + weite * 0.6, 0, g.henkel_u - 3], [r1 + 4, 0, g.henkel_u - 0.5],
                      [r1 - wand / 2, 0, g.henkel_u]],
              interp = "spline")
            circle(d = henkel_d);   // elliptic would only work as a polygon (README: F1/F3)
    }

    anchor rand_mitte = g[achse, _, rand], dir = [0, 0, 1];
}

b: becher();
