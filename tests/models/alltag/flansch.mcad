// Zweck: flange plate with collar and bolt circle (DN 25-like, 6 × M10) – cross-section as
// polygon from a 2D grid, rotate_extrude; collar/disc transition rounded via a ring zone
// (own module as zone), bore edges and outer edges chamfered via volume zones,
// through holes on the bolt circle via for/rotate and sealing groove with difference(chamfer = …).
// Dimensions in mm. (torus() as a zone selects no edges, see README: F7.)

// Zone: flat ring around the circle with radius r at height z
module ringzone(r, z, d = 2) {
    translate([0, 0, z]) difference() {
        cylinder(h = d, r = r + d / 2, center = true);
        cylinder(h = 2 * d, r = r - d / 2, center = true);
    }
}
module flansch(d_aussen = 120, t = 12, d_bund = 60, h_bund = 28, d_bohrung = 32,
               lk = 90, n = 6, d_loch = 11, nut_t = 1.5) {
    // Cross-section: x = radius, y = height
    grid p {
        x: bohrung = d_bohrung / 2, bund = d_bund / 2, aussen = d_aussen / 2;
        y: unten = 0, scheibe = t, bund_o = h_bund;
    }
    grid g {
        x: achse = 0, bund = d_bund / 2, lochkreis = lk / 2, aussen = d_aussen / 2;
        z: unten = 0, scheibe = t, bund_o = h_bund;
    }

    difference(chamfer = 0.8) {
        chamfer(1.5) {
            fillet(4) {
                rotate_extrude()
                    polygon([p[bohrung, unten], p[aussen, unten], p[aussen, scheibe], p[bund, scheibe],
                             p[bund, bund_o], p[bohrung, bund_o]]);
                ringzone(g.bund, g.scheibe);                        // Fillet collar/disc
            }
            cylinder(h = 3 * h_bund, r = d_bohrung / 2 + 1, center = true);  // both bore edges
            ringzone(g.aussen, g.scheibe);                                // Outer edge at the top
            ringzone(g.bund, g.bund_o);                                   // Collar edge at the top
        }
        for (i = [0 : n - 1])
            rotate([0, 0, i * 360 / n + 30]) translate([g.lochkreis, 0, -1]) cylinder(h = t + 2, d = d_loch);
        // Sealing groove on the underside
        translate([0, 0, -1]) difference() {
            cylinder(h = nut_t + 1, r = d_bohrung / 2 + 9);
            translate([0, 0, -1]) cylinder(h = nut_t + 3, r = d_bohrung / 2 + 5);
        }
    }

    anchor oben = g[achse, _, bund_o], dir = [0, 0, 1];
    anchor dichtflaeche = g[achse, _, unten], dir = [0, 0, -1];
}

f: flansch();
