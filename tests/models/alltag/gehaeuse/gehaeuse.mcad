// Zweck: electronics enclosure with lid and four screws (assembly of three files) –
// dimensions via include (masse.mcad), parts via use (teile.mcad). Base with shell and
// bosses (named instances dom[i] in the module), lid at the base's anchor, screws as
// parts s[0] … s[3] in a loop. `explosion` > 0 moves lid and screws
// apart (view); at 0 the assembly is closed (check the fit:
// `mcad measure gehaeuse.mcad --interference --clearance unterteil deckel`). Dimensions in mm.
include <masse.mcad>
use <teile.mcad>

explosion = 0;

unterteil: unterteil();
translate(unterteil.deckel_auflage + [0, 0, explosion]) deckel: deckel();
for (i = [0 : 3])
    translate([dom_pos(i).x, dom_pos(i).y, hoehe + deckel_t + 2 * explosion]) s[i]: schraube();
