// Dimensions of the hinge (via include): length, knuckles, clearances
laenge = 60;
augen = 5;              // Number of knuckles (odd: A outside)
auge_r = 4;             // Outer radius of the knuckles
blatt_t = 2.5;          // Leaf thickness
spiel = 0.4;            // Axial and radial clearance between A and B
bohrung_a = 3.0;        // Bore of leaf A (pin is glued in)
bohrung_b = 3.4;        // Bore of leaf B (turns freely on the pin)
stift_d = 2.95;         // (3.0 in 3.0: coincident cylinders, union fails, README: F11)
