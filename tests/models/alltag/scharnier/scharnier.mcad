// Zweck: printable 60 mm hinge of three parts (leaf A, leaf B, pin) – dimensions via
// include, parts via use; the knuckles of both leaves from the same function (axial clearance),
// clearances via for, leaf B rotated about the axis to the opening angle. Check:
// `mcad measure scharnier.mcad --interference --clearance a b` (clearance 0.4 mm) and pin ↔ B.
// Dimensions in mm.
include <masse.mcad>
use <teile.mcad>

winkel = 180;     // Opening angle between the leaves (180 = flat; below approx. 40° the leaves touch)

a: blatt(seite = 0, l = laenge, n = augen, r = auge_r, t = blatt_t, spiel = spiel, bohrung = bohrung_a);
rotate([180 - winkel, 0, 0])
    b: blatt(seite = 1, l = laenge, n = augen, r = auge_r, t = blatt_t, spiel = spiel, bohrung = bohrung_b);
translate(a.achse_anfang) stift: stift(l = laenge, d = stift_d);
