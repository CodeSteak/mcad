// Zweck: wall hook (jacket, towel) – wall plate with corners rounded via zones and a
// chamfered front edge (nested: chamfer catches the boundary edges of the rounding),
// two countersunk holes (cone, 4 mm screws), hook as a sweep of a circle along a
// spline path, ball knob at the end, attached with union(fillet = …). Dimensions in mm, wall = plane y = 0.
module wandhaken(b = 32, h = 80, t = 6, ecke = 8, schraube_d = 4.2, kopf_d = 8.5,
                 haken_d = 9, ausladung = 38, knauf_d = 14) {
    grid g {
        x: links = 0, mitte = b / 2, rechts = b;
        y: wand = 0, vorne = t;
        z: unten = 0, loch_u = 15, haken = h * 0.45, loch_o = h - 15, oben = h;
    }

    difference() {
        union(fillet = 2.5) {
            chamfer(1) {
                fillet(ecke) {
                    box(g[links, wand, unten], g[rechts, vorne, oben]);
                    zone(g[links, *, unten], d = 1);
                    zone(g[rechts, *, unten], d = 1);
                    zone(g[links, *, oben], d = 1);
                    zone(g[rechts, *, oben], d = 1);
                }
                zone(g.vorne, d = 1);
            }
            sweep(path = [g[mitte, vorne, haken] - [0, 2, 0], g[mitte, vorne, haken] + [0, 12, -2],
                          g[mitte, vorne, haken] + [0, ausladung - 8, 4],
                          g[mitte, vorne, haken] + [0, ausladung, 18]], interp = "spline")
                circle(d = haken_d);
            translate(g[mitte, vorne, haken] + [0, ausladung, 18]) sphere(d = knauf_d);
        }
        // 90° countersunk holes: through hole plus cone up to the front
        for (z = [g.loch_u, g.loch_o]) {
            translate([g.mitte, -1, z]) rotate([-90, 0, 0]) cylinder(h = t + 2, d = schraube_d);
            translate([g.mitte, t - (kopf_d - schraube_d) / 2, z]) rotate([-90, 0, 0])
                cylinder(h = (kopf_d - schraube_d) / 2 + 0.01, r1 = schraube_d / 2, r2 = kopf_d / 2);
        }
    }

    anchor knauf = g[mitte, vorne, haken] + [0, ausladung, 18], dir = [0, 1, 1];
}

haken: wandhaken();
