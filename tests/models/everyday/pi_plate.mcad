// Purpose: mounting plate for a Raspberry Pi (hole pattern 58 × 49 mm, M2.5) – hole pattern as
// grid planes, standoffs as an own module with an anchor, placed in the loop as named
// instances boss[i] and attached with union(fillet = …); ventilation slots (for),
// M4 mounting holes with countersink (cone), plate corners rounded via zones.
// Board as a second part (dummy 85 × 56 × 1.6) on the plate's anchor. Dimensions in mm.
module standoff(h = 6, d = 6, core = 2.1) {
    difference() {
        cylinder(h = h, d = d);
        translate([0, 0, 1]) cylinder(h = h, d = core);   // Pilot hole for M2.5 (self-tapping)
    }
    anchor top = [0, 0, h], dir = [0, 0, 1];
}

module pi_plate(l = 100, b = 72, t = 3, corner = 6, height = 6, margin_x = 10, margin_y = 8,
                slots = 6) {
    grid g {
        x: left = 0, right = l, pi_x0 = margin_x, hole_left = margin_x + 3.5, hole_right = margin_x + 3.5 + 58,
           mount = [5, l - 5], slot = [for (i = [0 : slots - 1]) margin_x + 18 + i * 7];
        y: front = 0, back = b, pi_y0 = margin_y, hole_front = margin_y + 3.5, hole_back = margin_y + 3.5 + 49,
           mount_y = [5, b - 5], slot_front = margin_y + 14, slot_back = margin_y + 42;
        z: bottom = 0, top = t;
    }

    difference() {
        union(fillet = 1) {
            fillet(corner) {
                box(g[left, front, bottom], g[right, back, top]);
                zone(g[left, front, *], d = 1);
                zone(g[right, front, *], d = 1);
                zone(g[left, back, *], d = 1);
                zone(g[right, back, *], d = 1);
            }
            for (i = [0 : 3])
                // Plane names are not values: selection via the coordinates (g.name as a number)
                translate([i % 2 == 0 ? g.hole_left : g.hole_right, i < 2 ? g.hole_front : g.hole_back, g.top - 0.5])
                    boss[i]: standoff(h = height + 0.5);
        }
        // Ventilation slots under the processor
        for (i = [0 : slots - 1])
            hull_slot(g[slot[i], slot_front, bottom] - [0, 0, 1], g[slot[i], slot_back, bottom] - [0, 0, 1],
                      3, t + 2);
        // M4 mounting with 90° countersink
        for (x = [g.mount[0], g.mount[1]], y = [g.mount_y[0], g.mount_y[1]]) {
            translate([x, y, -1]) cylinder(h = t + 2, d = 4.5);
            translate([x, y, t - 2]) cylinder(h = 2.01, r1 = 2.25, r2 = 4.25);
        }
    }

    anchor pi = g[pi_x0, pi_y0, top] + [0, 0, height], dir = [0, 0, 1];
    anchor screw = boss[0].top, dir = [0, 0, 1];
}

// Slot between two points (centres), width w, height h
module hull_slot(a, e, w, h) {
    translate(a) cylinder(h = h, d = w);
    translate(e) cylinder(h = h, d = w);
    translate(a - [w / 2, 0, 0]) cube([w, e.y - a.y, h]);
}

// Board dummy Raspberry Pi (85 × 56 × 1.6, holes 2.7 in hole pattern 58 × 49)
module pi_board() {
    difference() {
        cube([85, 56, 1.6], $fillet = 0.5);
        for (x = [3.5, 61.5], y = [3.5, 52.5]) translate([x, y, -1]) cylinder(h = 4, d = 2.7);
    }
    color("green") translate([25, 18, 1.6]) cube([15, 15, 2.4]);      // SoC
    color("gray") translate([85 - 21, 2, 1.6]) cube([21, 53, 16]);     // USB/LAN block
}

plate: pi_plate();
translate(plate.pi) pi: pi_board();
