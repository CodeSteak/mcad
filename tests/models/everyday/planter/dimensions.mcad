// Dimensions of plant pot and saucer (via include)
pot_bottom = 72;        // Side length of the rounded square at the bottom
pot_top_d = 100;        // Diameter of the round opening
pot_h = 90;             // Height without feet
wall = 2.2;
floor_t = 3;
foot_h = 4;             // Feet (water drains under the pot)
gap = 4;                // Gap pot ↔ rim of the saucer

// Superellipse |x/a|^p + |y/a|^p = 1 as support points for spline (p = 2: circle, large: square)
function superellipse(a, p = 5, n = 24) =
    [for (i = [0 : n - 1]) let (w = i * 360 / n, c = cos(w), s = sin(w))
        [a * sign(c) * pow(abs(c), 2 / p), a * sign(s) * pow(abs(s), 2 / p)]];
