// Zweck: bottle – rotate_extrude of a polygon profile (profile x = radius, profile y = height;
// shown in the xz plane with the rotation axis z), partial revolution as a cutaway next to it,
// rounding of the shoulder and bottom edge via zones around the grid planes.
module flasche(r = 22, h = 80, hals = 9, hh = 16, angle = 360) {
    grid g {
        x: achse = 0, innen = hals, aussen = r;
        y: boden = 0, schulter = h - hh - 10, hals_u = h - hh, oben = h;
    }

    fillet(3) {
        rotate_extrude(angle = angle)
            polygon([g[achse, boden, _], g[aussen, boden, _], g[aussen, schulter, _],
                     g[innen, hals_u, _], g[innen, oben, _], g[achse, oben, _]]);
        translate([0, 0, g.schulter]) cylinder(h = 2, r = r + 2, center = true); // Shoulder edge
        translate([0, 0, g.boden]) cylinder(h = 1, r = r + 2, center = true);    // Bottom edge
    }
}

flasche();
translate([60, 0, 0]) flasche(angle = 270);
