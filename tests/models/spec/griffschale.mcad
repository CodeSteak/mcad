// Zweck: grip shell – shell(t) { body; zone } with the zone at the top grid plane (the
// top side is opened), body chamfered with $chamfer, cable exit via difference,
// screw bosses at indexed grid planes with difference(fillet = …) for the bore edges.
module griffschale(l = 90, b = 34, h = 18, wand = 1.6) {
    grid g {
        x: hinten = 0, vorn = l, dom = [l * 0.2, l * 0.8];
        y: links = 0, rechts = b, mitte = b / 2;
        z: boden = 0, oben = h;
    }

    difference() {
        shell(wand) {
            box(g[hinten, links, boden], g[vorn, rechts, oben], $chamfer = 4);
            zone(g.oben, d = 1);    // Lid side open
        }
        translate(g[vorn, mitte, 9]) cube([8, 10, 6], center = true); // Cable exit
    }

    // Screw bosses with rounded bore edge
    for (i = [0 : 1])
        difference(fillet = 0.5) {
            translate(g[dom[i], mitte, boden]) cylinder(h = h - 2, r = 3.5);
            translate(g[dom[i], mitte, 4]) cylinder(h = h, r = 1.2);
        }

    anchor deckel = g[hinten, links, oben], dir = [0, 0, 1];
}

s: griffschale();
