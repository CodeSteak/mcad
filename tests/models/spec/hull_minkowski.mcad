// Purpose: hull() and minkowski() in their exact special cases (plan 21): plate with round
// corners and slots (2D hull), rounded block (minkowski with sphere), grip as a capsule
// (spheres on an axis), tab of box and cylinder of equal height (prism), cushion of
// equal spheres (hull of the centres + offset) and a strip of linear_extrude +
// cylinder (Minkowski sum of two prisms).
module oblong(l = 20, d = 6) {
    hull() {
        circle(d = d);
        translate([l, 0]) circle(d = d);
    }
}

module plate(w = 60, t = 30, h = 4, r = 5) {
    difference() {
        linear_extrude(h) hull() {
            for (x = [0, w], y = [0, t]) translate([x, y]) circle(r);
        }
        for (y = [t / 4, 3 * t / 4]) translate([w / 4, y, -1]) linear_extrude(h + 2) oblong(w / 2, 5);
    }
}

plate();
translate([0, 50, 0]) minkowski() {
    cube([20, 20, 10]);
    sphere(2);
}
translate([40, 52, 0]) hull() {
    translate([0, 0, 3]) sphere(3);
    translate([0, 0, 25]) sphere(3);
}
translate([60, 52, 0]) hull() {
    translate([-5, -10, 0]) cube([5, 20, 4]);
    translate([12, 0, 0]) cylinder(r = 6, h = 4);
}
translate([0, 90, 2]) hull() {
    for (x = [0, 30], y = [0, 15], z = [0, 4]) translate([x, y, z]) sphere(2);
}
translate([50, 90, 0]) minkowski() {
    linear_extrude(3) polygon([[0, 0], [20, 0], [20, 4], [4, 4], [4, 15], [0, 15]]);
    cylinder(r = 1, h = 1);
}
