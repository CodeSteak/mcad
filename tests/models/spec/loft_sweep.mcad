// Purpose: profile operations – loft from circle to square (funnel), sweep of a circle
// along a spline path (grip bow) and of a linear path from grid points.
grid g {
    x: left = 0, mid = 20, right = 40;
    y: front = 0;
    z: bottom = 0, top = 15;
}

loft() {
    circle(10);
    translate([0, 0, 15]) square(14, center = true);
    translate([0, 0, 30]) circle(4);
}

translate([30, 0, 0])
    sweep(path = [g[left, front, bottom], g[mid, front, top], g[right, front, bottom]], interp = "spline")
        circle(2);

translate([30, 20, 0])
    sweep(path = [[0, 0, 0], [40, 0, 0], [40, 20, 0]], interp = "linear") square(3, center = true);
