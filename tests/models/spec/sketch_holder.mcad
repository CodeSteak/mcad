// Purpose: angle holder with rounded profile (plan 17.3) – L profile as a polygon; `fillet2d`
// with a zone rounds only the inner corner large (notch effect), one outer `fillet2d` all
// other corners small (the transitions of the large arc are tangential and do not count);
// extruded, with slots made by `stroke` of a line segment (round ends).
t = 6;       // Wall width
a = 40;      // Length of leg
h = 30;      // The holder's width
r_inner = 5;

module profile() polygon([[0, 0], [a, 0], [a, t], [t, t], [t, a], [0, a]]);

module oblong(p0, p1, d = 4.5) stroke(d) sketch(closed = false) {
    start(p0);
    line(to = p1);
}

difference() {
    linear_extrude(h) fillet2d(1) {
        fillet2d(r_inner) {
            profile();
            translate([t, t]) circle(1);   // Zone: inner corner.
        }
    }
    // Slots in the bottom (xz plane, through the wall, y)
    translate([0, -1, 0]) rotate([-90, 0, 0]) linear_extrude(t + 2) oblong([16, -h / 2], [32, -h / 2]);
    // and in the wall (yz plane, through the wall, x)
    translate([-1, 0, 0]) rotate([90, 0, 90]) linear_extrude(t + 2) oblong([16, h / 2], [32, h / 2]);
}
