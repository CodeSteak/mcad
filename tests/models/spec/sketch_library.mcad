// Purpose: modules as namespaces (plan 17.2) – a library `profile` containing sketch modules,
// and a parts library `parts` with constants, functions and submodules; it gets called from
// outside with a dot (`profile.star()`, `parts.screw(d = 3)`, nested,
// `parts.plate.hole_plate()`), functions and constants as in `parts.head(parts.M3)`.
module profile {
    module star(n = 5, r1 = 12, r2 = 5) sketch {
        start([r1, 0]);
        for (i = [1 : n]) {
            line(to = [r2 * cos(360 * (i - 0.5) / n), r2 * sin(360 * (i - 0.5) / n)]);
            line(to = [r1 * cos(360 * i / n), r1 * sin(360 * i / n)]);
        }
    }
    module oblong(l = 20, b = 6) sketch {
        start([0, -b / 2]);
        line(to = [l, -b / 2]);
        arc(to = [l, b / 2], r = b / 2);
        line(to = [0, b / 2]);
        arc(to = [0, -b / 2], r = b / 2);
    }
}

module parts(pitch = 10) {
    M3 = 3.2;                                   // Through hole for M3.
    function head(d) = 1.8 * d;                 // Head's diameter
    module screw(d = 3, l = 12) {
        cylinder(h = l, d = d);
        translate([0, 0, l]) cylinder(h = d * 0.6, d = head(d));
    }
    module plate {
        // sees `pitch` and `M3` of `parts` (as the defaults)
        module hole_plate(n = 3) {
            difference() {
                cube([n * pitch, pitch, 3]);
                for (i = [0 : n - 1]) translate([pitch * (i + 0.5), pitch / 2, -1]) cylinder(h = 5, d = M3);
            }
        }
    }
}

linear_extrude(3) profile.star();
translate([25, -3, 0]) linear_extrude(4) profile.oblong(l = 25);
translate([0, 30, 0]) parts.plate.hole_plate(n = 4);
for (i = [0 : 3]) translate([10 * (i + 0.5), 35, 3]) parts.screw(d = 3, l = 8);
translate([70, 0, 0]) cylinder(h = 2, d = parts.head(parts.M3));
