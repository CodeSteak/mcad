// Zweck: open sketches as a `sweep` path (plan 17.1): a pipe bend of line, tangential
// arc and line (smooth path: one curve, the profile is an annulus) in the xz plane,
// and a frame of a rectangular profile along a path with corners (mitre).
sweep() {
    rotate([90, 0, 0]) sketch(closed = false) {
        start([0, 0]);
        line(to = [30, 0]);
        arc(to = [45, 15]);                     // tangential: radius 15
        line(by = [0, 25]);
    }
    difference() {
        circle(4);
        circle(3);
    }
}

translate([0, 20, 0]) sweep() {
    sketch(closed = false) {
        start([0, 0]);
        line(to = [40, 0]);
        line(to = [40, 30]);
        line(to = [0, 30]);
    }
    square([3, 6], center = true);
}
