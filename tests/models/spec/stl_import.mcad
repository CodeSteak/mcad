// Zweck: STL import (plan 21, phase B) – the same bracket from tests/models/stl once as a B-rep and
// once as a plain mesh. A closed mesh with few faces automatically becomes a
// B-rep (booleans, roundings, measuring, STEP); `as = "mesh"` keeps the mesh (display,
// transformations, colours, export STL/3MF, measuring – no booleans).

// B-rep (automatic: closed, 8 faces) with a bore in the foot
color("blue") difference() {
    import("../stl/winkel.stl");
    translate([12, 5, -1]) cylinder(h = 5, r = 2);
}

// the same mesh without B-rep, mirrored next to it
translate([-5, 0, 0]) mirror([1, 0, 0]) color("orange") import("../stl/winkel.stl", as = "mesh");
