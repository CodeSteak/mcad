// Purpose: sign with relief text (plan 17.4, report 16) – base plate with rim, raised text in
// two fonts – multi-colour (3MF with one filament per colour).
// Fonts: the default is the stencil font "cad stencil mono" (stencil.mcad); also bundled
// are JetBrains Mono, Inter and Allerta Stencil, each with a style (`"Inter:style=Bold"`);
// own fonts with `font = "file.ttf"` (file in the project).
// `size` as in OpenSCAD: cap height about `size`.

width = 100;
height = 44;
thickness = 3;
r = 5;          // Corner radius
rim = 2;        // Width of the rim
relief = 1.2;   // Height of text and rim

module plate(b, h, r) sketch {
    start([r, 0]);
    line(to = [b - r, 0]);
    arc(center = [b - r, r], angle = 90);
    line(to = [b, h - r]);
    arc(center = [b - r, h - r], angle = 90);
    line(to = [r, h]);
    arc(center = [r, h - r], angle = 90);
    line(to = [0, r]);
    arc(center = [r, r], angle = 90);
}

color("white") linear_extrude(thickness) plate(width, height, r);

// Rim
color("blue") translate([0, 0, thickness]) linear_extrude(relief) difference() {
    plate(width, height, r);
    translate([rim, rim]) plate(width - 2 * rim, height - 2 * rim, r - rim);
}

// Title and subtitle raised
color("red") translate([width / 2, 26, thickness])
    linear_extrude(relief) text("Workshop", size = 11, font = "Inter:style=Bold", halign = "center", valign = "center");
color("black") translate([width / 2, 9, thickness])
    linear_extrude(relief) text("SAFETY GLASSES REQUIRED", size = 4.2, font = "Allerta Stencil", halign = "center");
