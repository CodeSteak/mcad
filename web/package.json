{
  "name": "controller-cad-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "smoke": "node scripts/smoke-node.mjs",
    "test:transport": "node scripts/test-transport.mjs",
    "typecheck": "tsc --noEmit -p .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=../reports/tmp/report2/vitest.json && playwright test && node ../tools/report/report2-ui.mjs",
    "test:report3": "mkdir -p ../reports/tmp/report3 && (cd .. && (cargo test -p cad-eval --test handles && cargo test -p cad-session) 2>&1 | tee reports/tmp/report3/cargo.txt | tail -3) && vitest run --reporter=default --reporter=json --outputFile.json=../reports/tmp/report3/vitest.json && playwright test && node ../tools/report/report3-ui.mjs"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  }
}
